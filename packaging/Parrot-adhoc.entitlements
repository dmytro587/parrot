<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Ad-hoc dev builds: Sparkle is re-signed separately from the main binary,
	     so Library Validation rejects it without a shared Team ID. Releases use
	     Developer ID signing and packaging/Parrot.entitlements instead. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
